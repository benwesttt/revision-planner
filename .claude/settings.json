{
  "permissions": {
    "allow": [
      "Bash(git status)", "Bash(git log*)", "Bash(git diff*)", "Bash(git pull)",
      "Bash(npm run *)", "Bash(npx eslint *)", "Bash(mkdir -p frontend/*)",
      "Edit(frontend/src/**)", "Write(frontend/src/**)",
      "Bash(./venv/Scripts/python.exe -m pytest*)",
      "Bash(./venv/Scripts/python.exe -m py_compile*)",
      "Bash(./venv/Scripts/alembic.exe current)",
      "Bash(git stash push*)", "Bash(git stash pop*)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(rm -rf*)", "Read(.env*)"
    ],
    "ask": [
      "Bash(git commit*)", "Bash(git push*)", "Bash(alembic*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
